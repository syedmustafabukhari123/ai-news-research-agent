# Copy this file to .env and provide keys from your own provider accounts.
GROQ_API_KEY=
TAVILY_API_KEY=

# Groq model currently listed as tool-capable; change when provider availability changes.
GROQ_MODEL=openai/gpt-oss-120b

# IANA timezone used for report dates and research windows.
APP_TIMEZONE=Asia/Karachi
RESEARCH_WINDOW_HOURS=24

# Hard-bounded free-tier-conscious search settings.
MAX_SEARCHES=2
TAVILY_MAX_RESULTS=3
REQUEST_TIMEOUT_SECONDS=120

# Optional absolute or project-relative output locations.
REPORT_DIR=reports
LOG_DIR=logs
LOG_LEVEL=INFO

# Optional: save a bounded local JSON evidence audit beside each report.
# Contains third-party source snippets; files are not published automatically.
EVIDENCE_AUDIT_ENABLED=false
